# Demo mode is the default. Leave the Supabase values blank to run the full UI
# on the sample book in this browser. Do not put real keys in git.

NEXT_PUBLIC_DATA_SOURCE=demo

# Required only when NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy name accepted if the publishable key above is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_. The demo app does not read it.
# Use it later for trusted jobs such as creating the first platform admin.
# SUPABASE_SECRET_KEY=
