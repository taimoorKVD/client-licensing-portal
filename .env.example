# Copy to .env.local. Do not commit real keys.
# If both public values below are set, the app requires a Supabase session.
# It will not fall back to the browser demo book.

# Public, safe to expose in the browser. Use the publishable key from
# Project Settings → API Keys. The legacy anon key is accepted only when
# the publishable key is empty.
NEXT_PUBLIC_SUPABASE_URL=https://ubipxntnfeohqcxwfyhs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy name accepted if the publishable key above is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_. Used only to create,
# ban, and delete auth users from server actions and /api/admin routes.
# The browser bundle does not read it. Leave it unset until an operator
# is ready to administer accounts.
SUPABASE_SECRET_KEY=

# Hostinger Node.js: set the same variables in the Node.js environment
# before the build. NEXT_PUBLIC_* values are inlined at build time.
# Start command: npm start. Do not publish the old static out/ directory.
