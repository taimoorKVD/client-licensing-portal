# Copy to .env.local. Do not commit real keys.
# When both public values below are set, the portal requires a signed-in
# session. It will not serve the sample book.

# Supabase project URL, for example https://ubipxntnfeohqcxwfyhs.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (or legacy anon) key. Safe for the browser. Not the service role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy name used only when the publishable key is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Required for issuing, disabling, and deleting accounts.
# SUPABASE_SECRET_KEY=

# Optional. Ignored once the public Supabase values are set.
# NEXT_PUBLIC_DATA_SOURCE=demo
